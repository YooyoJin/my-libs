{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-pc(仿真)",
            "type": "shell",
            "command": "cmake --build projects/gcc/build",
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "configure-pc(仿真)",
            "type": "shell",
            "command": "cmake -S projects/gcc -B projects/gcc/build -G \"MinGW Makefiles\"",
            "problemMatcher": []
        },
        {
            "label": "run-pc(仿真)",
            "type": "shell",
            "command": "projects/gcc/build/fanctrldemo.exe",
            "dependsOn": "build-pc(仿真)",
            "problemMatcher": []
        },
        {
            "label": "build-arm(交叉库)",
            "type": "shell",
            "command": "cmake -S projects/armgcc -B projects/armgcc/build -G \"MinGW Makefiles\" -DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/projects/armgcc/toolchainarmgcc.cmake && cmake --build projects/armgcc/build",
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}
